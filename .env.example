GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.8-flash
# LLM deadline only, in seconds (10-300); document/query embeddings keep theirs.
LLM_REQUEST_TIMEOUT_SECONDS=120
# Supported thinking levels: low, medium, high. Thoughts are not returned.
LLM_THINKING_LEVEL=medium
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072
# Live ingestion pacing and bounded 429 recovery; checkpoints survive restarts.
EMBEDDING_REQUEST_INTERVAL_SECONDS=6
EMBEDDING_MAX_RETRIES=2
EMBEDDING_MAX_RETRY_WAIT_SECONDS=60
CHROMA_PATH=./storage/chroma
CHROMA_COLLECTION=kingdomai_altheria_docs
KNOWLEDGE_BASE_PATH=./knowledge_base
EVAL_PATH=./eval
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
# Optional: leave empty until calibrated with positive and negative questions.
SIMILARITY_THRESHOLD=
